---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { Button } from '../../components/ui/button';
import { ArrowRight } from 'lucide-react';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const projectsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Projects: AI Automations & Calling Agents",
  "url": "https://saadrasheed.life/projects",
  "description": "Portfolio of AI calling agents and automation systems built by Saad Rasheed.",
  "hasPart": sortedProjects.map((p) => ({
    "@type": "CreativeWork",
    "name": p.data.title,
    "about": p.data.category,
    "description": p.data.description,
  })),
};
---

<Layout 
  title="Projects: AI Automations & Calling Agents | Saad Rasheed"
  description="Real AI automation projects: voice agents, lead recovery, contract review, BI chatbots, content engines and more. See the stack and the outcome."
  canonical="https://saadrasheed.life/projects"
  schema={projectsSchema}
>
  <Navbar client:load currentPath={Astro.url.pathname} />
  
  <main class="pt-28 md:pt-36">
    <section class="container">
      <div class="text-center max-w-2xl mx-auto mb-14 fade-in-up">
        <p class="text-xs uppercase tracking-[0.2em] text-primary-glow mb-3">
          Projects
        </p>
        <h1 class="text-4xl md:text-6xl font-extrabold mb-4 leading-tight">
          Work I've <span class="gradient-text">Shipped</span>
        </h1>
        <p class="text-lg text-muted-foreground">
          Real AI systems running in production. Real businesses. Zero fluff.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 lg:gap-6">
        {sortedProjects.map((p) => (
          <article class="group relative rounded-2xl bg-card border border-border/60 overflow-hidden hover:border-primary-glow/50 hover:shadow-[0_10px_40px_-10px_hsl(270_80%_50%/0.35)] transition-all fade-in-up flex flex-col h-full">
            <div class={`relative h-2 bg-gradient-to-r ${p.data.gradient}`} />

            <div class="p-7 lg:p-8 space-y-5 flex-1 flex flex-col">
              <div class="flex items-center gap-2">
                <span class="text-[11px] uppercase tracking-[0.18em] text-primary-glow font-semibold">
                  {p.data.category}
                </span>
              </div>

              <h2 class="text-xl md:text-2xl font-bold leading-snug">
                {p.data.title}
              </h2>

              <p class="text-muted-foreground text-sm leading-relaxed">
                {p.data.description}
              </p>

              <blockquote class="relative rounded-xl bg-primary/10 border border-primary/20 px-4 py-3 mb-2 mt-auto">
                <span class="absolute -top-2 left-3 text-xs px-2 py-0.5 rounded-md bg-primary text-primary-foreground font-semibold">
                  Consider this
                </span>
                <p class="text-sm italic text-foreground mt-1">
                  "{p.data.hook}"
                </p>
              </blockquote>

              <div class="flex flex-wrap gap-2 pt-1 mb-2">
                {p.data.tags.map((tag) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-secondary border border-border text-muted-foreground">
                    {tag}
                  </span>
                ))}
              </div>

              <a 
                href={`/projects/${p.id}`} 
                class="w-full inline-flex items-center justify-center gap-2 whitespace-normal h-auto text-center py-2.5 rounded-md text-sm font-semibold gradient-primary text-white shadow-[0_4px_12px_rgba(139,92,246,0.2)] transition-all duration-300 ease-out group-hover:scale-[1.02] group-hover:shadow-[0_12px_30px_-5px_hsl(270_80%_50%/0.65)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                <span class="hidden sm:inline">View more details about the project</span>
                <span class="sm:hidden">View project details</span>
                <ArrowRight class="ml-2 h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="py-20 md:py-28">
      <div class="container">
        <div class="relative rounded-3xl overflow-hidden border border-primary-glow/30 bg-gradient-to-br from-card to-[hsl(270_30%_10%)] p-10 md:p-16 text-center fade-in-up">
          <div class="absolute inset-0 grid-bg opacity-30" />
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] radial-glow animate-pulse-glow" />
          <div class="relative space-y-6">
            <h2 class="text-3xl md:text-5xl font-extrabold leading-tight">
              Want a system like these?
            </h2>
            <p class="text-lg text-muted-foreground max-w-xl mx-auto">
              Let's map your AI workflow in a free 30-minute call.
            </p>
            <a 
              href="https://cal.com/saadrasheed/free-strategy-call" 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 whitespace-normal h-auto min-h-14 py-3.5 px-5 sm:px-9 rounded-xl text-sm sm:text-base font-semibold text-center leading-tight gradient-primary text-white shadow-[0_10px_40px_-10px_hsl(270_80%_50%/0.65)] hover:shadow-[0_15px_50px_-10px_hsl(270_85%_55%/0.75)] hover:-translate-y-0.5 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              Book a Free Strategy Call
              <ArrowRight class="ml-1 h-4 w-4 shrink-0" />
            </a>
            <p class="text-xs text-muted-foreground">Takes 30 seconds to book · No commitment</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer client:visible />
</Layout>
